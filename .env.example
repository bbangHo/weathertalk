# 날씨톡톡 비밀값·외부 키 목록.
# 사용법: 이 파일을 저장소 루트에 .env로 복사하고 값을 채운다(.env는 git에서 제외). 백엔드는 기동 시 ../.env 또는 backend/.env를 읽는다.
# 형식: KEY=값 (따옴표 없이, 한 줄에 하나). 같은 이름의 OS 환경 변수가 있으면 그쪽이 이긴다. 빈 값은 '설정 안 함'.
# 새 키가 필요하면 여기에 변수(빈 값 + 한 줄 설명 + 발급처)를 추가하고 application.yml에서 ${변수명:}으로 참조한다.

# ── member ─────────────────────────────────────────────────────────────────────
# 접근·갱신 토큰 서명 비밀값(32자 이상, 무작위). 직접 생성(예: openssl rand -base64 48). local·test는 비우면 개발용 기본값, prod·staging은 필수. [M1]
MEMBER_TOKEN_SECRET=

# ── weather ────────────────────────────────────────────────────────────────────
# 기상청 인증키(공공데이터포털 '일반 인증키(Decoding)'). 발급: data.go.kr — 기상청_단기예보·중기예보·생활기상지수 조회서비스 활용신청. 비면 수집 생략. [M2]
WEATHER_KMA_SERVICE_KEY=
# 에어코리아 인증키(Decoding). 발급: data.go.kr — 한국환경공단_에어코리아_대기오염정보·측정소정보 활용신청. 비면 대기질 수집 생략. [M2]
WEATHER_AIRKOREA_SERVICE_KEY=

# ── 운영 DB·Redis (prod·staging 프로파일에서만 읽는다. 로컬은 Docker Compose 자동 연결) ──────────
# PostgreSQL(PostGIS) JDBC 주소. 예: jdbc:postgresql://db:5432/weathertalk. 운영 compose에서 정한다. [M8]
DB_URL=
# DB 사용자 이름. [M8]
DB_USERNAME=
# DB 비밀번호. [M8]
DB_PASSWORD=
# Redis 주소. 예: redis://:비밀번호@redis:6379. [M8]
REDIS_URL=

# ── 예약 (아직 코드가 읽지 않는다. 해당 마일스톤에서 주석을 풀고 application.yml에 연결) ─────────────
# 객체 저장소(SeaweedFS, S3 API) — 커뮤니티 사진. [M4]
# 백엔드가 접근하는 내부 S3 주소. 예: http://seaweedfs:8333 (path-style)
# S3_ENDPOINT=
# 사전 서명 URL에 쓰는 공개 기준 주소(앱이 직접 올리고 받는 주소). 내부 주소와 다를 수 있다.
# S3_PUBLIC_ENDPOINT=
# 서명 리전. SeaweedFS는 임의 값(예: us-east-1)
# S3_REGION=
# 사진 버킷 이름
# S3_BUCKET=
# S3 접근 키·비밀 키. 발급: SeaweedFS s3 설정(identities)에서 생성
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# 소셜 로그인 — 카카오. 발급: Kakao Developers 앱 등록. [M7]
# 앱 키(토큰 검증 시 앱 ID 확인용)
# KAKAO_APP_ID=
# 어드민 키(탈퇴 시 연결 끊기 API)
# KAKAO_ADMIN_KEY=

# 소셜 로그인 — 애플. 발급: Apple Developer(Sign in with Apple, 키 생성). [M7]
# ID 토큰 aud(번들 ID 또는 Services ID)
# APPLE_CLIENT_ID=
# 팀 ID·키 ID·개인 키(.p8) 경로 — 탈퇴 시 토큰 철회(revoke)용 클라이언트 시크릿 서명
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=

# 소셜 로그인 — 구글. 발급: Google Cloud Console OAuth 클라이언트(Android·iOS·웹). [M7]
# ID 토큰 aud로 허용할 클라이언트 ID(쉼표 구분)
# GOOGLE_CLIENT_IDS=

# 푸시 알림 — FCM. 발급: Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 키(JSON). 파일은 저장소 밖에 둔다. [M7]
# FIREBASE_CREDENTIALS_PATH=
