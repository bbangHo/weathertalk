# 날씨톡톡 비밀값·외부 키 목록.
# 사용법: 이 파일을 저장소 루트에 .env로 복사하고 값을 채운다(.env는 git에서 제외). 백엔드는 기동 시 ../.env 또는 backend/.env를 읽는다.
# 형식: KEY=값 (따옴표 없이, 한 줄에 하나). 같은 이름의 OS 환경 변수가 있으면 그쪽이 이긴다. 빈 값은 '설정 안 함'.
# 새 키가 필요하면 여기에 변수(빈 값 + 한 줄 설명 + 발급처)를 추가하고 application.yml에서 ${변수명:}으로 참조한다.

# ── member ─────────────────────────────────────────────────────────────────────
# 접근·갱신 토큰 서명 비밀값(32자 이상, 무작위). 직접 생성(예: openssl rand -base64 48). local·test는 비우면 개발용 기본값, prod·staging은 필수. [M1]
MEMBER_TOKEN_SECRET=
# 애플·구글 연결 해제용 토큰(로그인 때 받은 갱신 토큰) 암호화 키(32자 이상, 무작위). 직접 생성(예: openssl rand -base64 48).
# 비우면 local·test는 개발용 기본값, prod·staging은 토큰을 보관하지 않는다(탈퇴 때 애플·구글 연결 해제 생략). 한번 정하면 바꾸지 않는다(바꾸면 보관분을 못 푼다). [M7]
MEMBER_PROVIDER_TOKEN_KEY=

# ── weather ────────────────────────────────────────────────────────────────────
# 기상청 인증키(공공데이터포털 '일반 인증키(Decoding)'). 발급: data.go.kr — 기상청_단기예보·중기예보·생활기상지수 조회서비스 활용신청. 비면 수집 생략. [M2]
WEATHER_KMA_SERVICE_KEY=
# 에어코리아 인증키(Decoding). 발급: data.go.kr — 한국환경공단_에어코리아_대기오염정보·측정소정보 활용신청. 비면 대기질 수집 생략. [M2]
WEATHER_AIRKOREA_SERVICE_KEY=

# ── 운영 DB·Redis (prod·staging 프로파일에서만 읽는다. 로컬은 Docker Compose 자동 연결) ──────────
# PostgreSQL(PostGIS) JDBC 주소. 예: jdbc:postgresql://db:5432/weathertalk. 운영 compose에서 정한다. [M8]
DB_URL=
# DB 사용자 이름. [M8]
DB_USERNAME=
# DB 비밀번호. [M8]
DB_PASSWORD=
# Redis 주소. 예: redis://:비밀번호@redis:6379. [M8]
REDIS_URL=

# ── community: 객체 저장소(SeaweedFS, S3 API) — 커뮤니티 사진 ───────────────────────────────
# 비우면 기동은 되고 사진 업로드만 '일시적으로 사용할 수 없음'으로 응답한다. [M4]
# 백엔드가 접근하는 내부 S3 주소(path-style). 로컬 compose: http://localhost:8333 / 운영 compose: http://seaweedfs:8333
S3_ENDPOINT=
# 사전 서명 URL의 공개 기준 주소(앱이 직접 올리고 받는 주소). 비우면 S3_ENDPOINT와 같다.
# 실기기 테스트는 PC의 LAN 주소(예: http://192.168.0.10:8333). 운영은 전용 호스트(예: https://img.example.com) — 경로 접두어 불가, Host 헤더 유지 프록시.
S3_PUBLIC_ENDPOINT=
# 서명 리전. SeaweedFS는 아무 값이나 된다(기본 us-east-1)
S3_REGION=us-east-1
# 사진 버킷 이름(기본 weathertalk-images). 없으면 백엔드가 만든다
S3_BUCKET=weathertalk-images
# S3 접근 키·비밀 키. 직접 생성(예: openssl rand -hex 16 / openssl rand -base64 32).
# 로컬 compose는 이 값으로 SeaweedFS 관리자 신원을 만든다(backend/compose.yaml). 운영은 weed shell의 s3.configure로 등록
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── 소셜 로그인 (비우면 그 제공자 로그인은 503 '일시적으로 사용할 수 없음', 로그인 수단 목록에서 빠짐) ──────────────

# 카카오. 발급: Kakao Developers(developers.kakao.com) → 내 애플리케이션 → 앱 설정. [M7]
# 앱 ID(숫자, '앱 키' 화면 위쪽 '앱 ID'). 앱이 준 접근 토큰의 app_id와 같아야 로그인된다(다른 앱 토큰 거부)
KAKAO_APP_ID=
# 어드민 키(앱 키 → 어드민 키). 탈퇴·계정 해제 시 연결 끊기(unlink) 호출용. 서버에만 둔다
KAKAO_ADMIN_KEY=

# 애플. 발급: Apple Developer(developer.apple.com) → Certificates, Identifiers & Profiles. [M7]
# identity token aud로 허용할 클라이언트 ID = iOS 앱 번들 ID(예: kr.weathertalk.app). 여러 개면 쉼표 구분
APPLE_CLIENT_ID=
# 팀 ID(Membership 화면의 10자리), Sign in with Apple 키의 키 ID(10자리), 그 키 파일(AuthKey_XXXX.p8)의 경로(저장소 밖).
# 로그인 때 인가 코드 → 갱신 토큰 교환과 탈퇴 때 토큰 철회(revoke)의 클라이언트 시크릿(ES256) 서명에 쓴다. 비면 철회만 생략
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# 구글. 발급: Google Cloud Console(console.cloud.google.com) → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID. [M7]
# ID 토큰 aud로 허용할 클라이언트 ID(쉼표 구분): Android 클라이언트, iOS 클라이언트, 그리고 앱이 ID 토큰을 요청할 때 쓰는 웹 클라이언트
GOOGLE_CLIENT_IDS=
# 서버 인가 코드를 교환할 웹 애플리케이션 클라이언트 ID·시크릿(탈퇴 때 토큰 철회용 갱신 토큰 획득). 비면 철회만 생략
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_SERVER_CLIENT_SECRET=

# ── 푸시 알림 ──────────────────────────────────────────────────────────────────
# FCM. 발급: Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성(JSON). 파일은 저장소 밖에 두고 경로만 적는다. [M7]
# 비우면 기동은 되고 발송만 꺼진다(경고 로그, 발송 기록은 '생략(발송 비활성)')
FIREBASE_CREDENTIALS_PATH=
