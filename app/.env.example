# 앱 환경 변수 (Expo는 EXPO_PUBLIC_ 접두어 변수만 앱 번들에 넣는다 — 비밀값을 두지 않는다)
# 사용: cp .env.example .env 후 값 수정. .env는 git에 올라가지 않는다.

# 백엔드 API 주소. 비우면 개발 기본값 http://localhost:8080
# 실기기 테스트 때는 PC의 LAN 주소(예: http://192.168.0.10:8080), Android 에뮬레이터는 http://10.0.2.2:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 이용약관·개인정보처리방침 주소(마이페이지에서 브라우저로 연다). 비우면 "준비 중"으로 보인다.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
