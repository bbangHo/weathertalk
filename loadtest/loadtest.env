# 부하테스트용 백엔드 환경 변수. 비밀값 없음 — 저장소에 둬도 된다.
# 쓰는 법(Git Bash): set -a; . loadtest/loadtest.env; set +a; 그다음 bootRun. docker compose는 env_file로 넣는다.

# ── 외부 API 차단 (필수) ──────────────────────────────────────────
# C 모드(기본): 기상청·에어코리아 주소를 로컬 모의 서버(mock-weather.js, 18090)로 돌린다. 외부 호출 0건.
# 키는 '설정됨'으로 보이게 하는 가짜 값이다. 모의 서버만 받고 밖으로 나가지 않는다(실제 키를 넣지 않는다).
# OS 환경 변수가 .env보다 이기므로, 저장소 루트 .env에 실제 키가 있어도 아래 값이 우선한다.
WEATHER_KMA_SERVICE_KEY=loadtest-fake-key
WEATHER_AIRKOREA_SERVICE_KEY=loadtest-fake-key
WEATHER_SOURCE_KMA_BASEURL=http://localhost:18090/kma
WEATHER_SOURCE_AIRKOREA_BASEURL=http://localhost:18090/air
# A 모드(날씨 없이, 홈이 가볍게 측정됨): 위 네 줄 대신
#   WEATHER_KMA_SERVICE_KEY=  WEATHER_AIRKOREA_SERVICE_KEY=  (키가 비면 수집 전에 멈춘다)
#   WEATHER_SOURCE_KMA_BASEURL=http://127.0.0.1:9  WEATHER_SOURCE_AIRKOREA_BASEURL=http://127.0.0.1:9 (닫힌 포트)
# 푸시(FCM)도 끈다: 자격 파일이 없으면 발송만 꺼진다.
FIREBASE_CREDENTIALS_PATH=

# ── 쓰기 제한 완화 ─────────────────────────────────────────────
# 같은 테스트 회원이 짧은 시간에 여러 번 쓰게 한다(운영값: 체감 1h, 제보 30m·하루 20건).
FEELING_RECORDINTERVAL=0s
WEATHER_FIELDREPORT_MININTERVAL=0s
WEATHER_FIELDREPORT_DAILYLIMIT=1000000

# 8080이 다른 프로젝트에 잡혀 있어도 겹치지 않게 한다.
SERVER_PORT=18080
MANAGEMENT_SERVER_PORT=18081

# 측정용: Hikari 풀·HTTP 지연·JVM 지표를 관리 포트(18081)의 /actuator/metrics 로 연다(로컬 전용 포트).
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,modulith,metrics
